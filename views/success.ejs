<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Booking Confirmed</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<header><div class="wrap"><h1>Booking confirmed</h1></div></header>
<main class="wrap">
  <div class="confirm-card">
    <p>Your payment was successful. Status: <strong><%= session.payment_status %></strong></p>
    <p>Amount paid: $<%= (session.amount_total / 100).toFixed(2) %></p>
    <a href="/" class="btn">Book another ticket</a>
  </div>
</main>
</body>
</html>
