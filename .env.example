# Local (non-Docker) development uses this connection string.
# When running via docker-compose, DATABASE_URL is overridden automatically
# in docker-compose.yml to point at the "db" container instead of localhost.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/busticketing

# Get these from https://dashboard.stripe.com/test/apikeys (make sure you're
# in TEST mode, toggle is top-right of the Stripe dashboard). Never commit
# real values here — this file is just a template.
STRIPE_SECRET_KEY=sk_test_your_test_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key_here

PORT=3000
